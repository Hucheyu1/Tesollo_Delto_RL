{
  "encoder_decoder_cfg": {
    "encoder_depth": 12,
    "encoder_embed_dim": 384,
    "encoder_n_heads": 6,
    "decoder_depth": 6,
    "decoder_embed_dim": 192,
    "decoder_n_heads": 6
  },
  "train_cfg": {
    "optimizer": "adamw",
    "schedule": "linear-warmup+cosine-decay",
    "base_lr": 0.00015,
    "min_lr": 0.0,
    "effective_bsz": 64,
    "betas": [
      0.9,
      0.95
    ],
    "weight_decay": 0.05,
    "mlp_ratio": 4.0,
    "norm_pixel_loss": true,
    "use_cls_token": true
  },
  "input_cfg": {
    "patch_size": 16,
    "mask_ratio": 0.75,
    "tactile_dim": 20,
    "tactile_en_dim": 768,
    "tactile_type": "binary",
    "tactile_emb_type": "separate",
    "tactile_mask_ratio": 0.5,
    "tactile_set_to_ZERO": false,
    "img_weight": 1.0,
    "tac_weight": 10.0
  },
  "dataset_cfg": {
    "resolution": 224,
    "in_channels": 3,
    "warmup_epochs": 20,
    "max_epochs": 400
  }
}