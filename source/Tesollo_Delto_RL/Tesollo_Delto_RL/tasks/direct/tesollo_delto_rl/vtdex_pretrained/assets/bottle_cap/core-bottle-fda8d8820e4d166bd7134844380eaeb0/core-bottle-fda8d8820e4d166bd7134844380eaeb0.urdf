<robot name="root">
  <link name="bottle_body">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="bottle_piece_1.obj" scale="1.0000E-01 1.0000E-01 1.0000E-01"/>
      </geometry>
      <material name="bottle_body_material">
        <color rgba="6.00E-01 2.00E-01 2.00E-01 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="bottle_piece_1.obj" scale="1.0000E-01 1.0000E-01 1.0000E-01"/>
      </geometry>
    </collision>
  </link>
  <link name="bottle_cap">
    <visual>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry>
        <mesh filename="bottle_piece_0.obj" scale="1.0000E-01 1.0000E-01 1.0000E-01"/>
      </geometry>
      <material name="bottle_cap_material">
        <color rgba="3.00E-01 6.00E-01 6.00E-01 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry>
        <mesh filename="bottle_piece_0.obj" scale="1.0000E-01 1.0000E-01 1.0000E-01"/>
      </geometry>
    </collision>
  </link>
  <joint name="bottle_cap_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="bottle_body"/>
    <child link="bottle_cap"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.00" upper="6.28" effort="100.0" velocity="10.0"/>
    <dynamics damping="0.1"/>
  </joint>
</robot>
